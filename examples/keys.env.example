# Either export these, or put each key alone in a file under ~/.config/agent-search/ (chmod 600):
#   exa_key, tavily_key, jina_key, gemini_key, deepseek_key, responses_key, openai_key
export EXA_API_KEY=replace-me
export TAVILY_API_KEY=replace-me
export JINA_API_KEY=replace-me            # optional; jina_read falls back to the keyless reader
export GEMINI_API_KEY=replace-me
export DEEPSEEK_API_KEY=replace-me
export RESPONSES_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible Responses endpoint
export RESPONSES_API_KEY=replace-me
export WEB_SEARCH_MODEL=replace-with-a-model-that-supports-web_search
# GitHub: GITHUB_TOKEN / GH_TOKEN, or a logged-in `gh` CLI (optional)
